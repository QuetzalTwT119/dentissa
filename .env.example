APP_NAME=Dentissa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# 30 minutos sin actividad: el panel muestra datos clínicos.
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
REVERB_APP_ID=dentissa-local
REVERB_APP_KEY=dentissa-local-key
REVERB_APP_SECRET=dentissa-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_CLIENT_HOST=localhost
REVERB_ALLOWED_ORIGINS=localhost:8000,127.0.0.1:8000
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# La portada muestra datos ficticios con aviso mientras este modo esté activo.
# Antes de publicar para pacientes, configúralo en false y completa los datos reales.
DENTISSA_MODO_DEMO=true
DENTISSA_TELEFONO=
DENTISSA_CORREO=
DENTISSA_DIRECCION=
# Aviso de privacidad: datos del responsable (los llena la clínica). Pon
# DENTISSA_AVISO_REVISADO=true solo cuando un abogado o la clínica lo aprueben.
DENTISSA_PRIVACIDAD_RESPONSABLE=
DENTISSA_PRIVACIDAD_DOMICILIO=
DENTISSA_PRIVACIDAD_CORREO=
DENTISSA_AVISO_REVISADO=false
# Respaldos cifrados a Google Drive (Manual Técnico 14.1). Genera la llave con
# php artisan dentissa:respaldo-llave y guárdala también fuera del servidor.
DENTISSA_RESPALDO_CLAVE=
DENTISSA_RESPALDO_DIAS=30
# Verificación en dos pasos obligatoria para el administrador. Solo una demo
# sin pacientes reales puede ponerla en false.
DENTISSA_2FA_ADMIN=true
DENTISSA_HORARIO_TEXTO=
DENTISSA_TELEGRAM_USUARIO=@dentissa_demo
DENTISSA_TELEGRAM_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp Cloud API (Meta). Sin estas dos, las notificaciones de citas
# se registran igual (auditoría) pero solo se envían por correo.
DENTISSA_WHATSAPP_PHONE_ID=
DENTISSA_WHATSAPP_TOKEN=
DENTISSA_WHATSAPP_API_VERSION=v21.0
DENTISSA_WHATSAPP_IDIOMA=es_MX
# Webhook de respuestas: secreto de la app (Meta → Configuración → Básica) y
# un token de verificación que tú inventas y escribes igual en Meta.
DENTISSA_WHATSAPP_APP_SECRET=
DENTISSA_WHATSAPP_VERIFY_TOKEN=

# Telegram. Guarda el token de @BotFather solo en tu .env local.
DENTISSA_TELEGRAM_BOT_TOKEN=

# Seeder manual y exclusivo para la demostración escolar en Railway.
# Déjalo desactivado; las contraseñas reales van solo en variables privadas.
DENTISSA_DEMO_SEED_ENABLED=false
DENTISSA_DEMO_ADMIN_EMAIL=
DENTISSA_DEMO_ADMIN_PASSWORD=
DENTISSA_DEMO_ASISTENTE_EMAIL=
DENTISSA_DEMO_ASISTENTE_PASSWORD=

# Prototipo local de IA (apagado por defecto). Para Ollama dentro de Docker:
# habilítalo únicamente en tu .env local y arranca el perfil `ia`.
DENTISSA_ASISTENTE_IA_HABILITADA=false
DENTISSA_OLLAMA_BASE_URL=http://ollama:11434
DENTISSA_OLLAMA_MODELO=granite3.3:2b
DENTISSA_OLLAMA_TIMEOUT=60
DENTISSA_ASISTENTE_IA_MAX_FUENTES=30

VITE_APP_NAME="${APP_NAME}"
